{
  "name": "EDP-Serial-ESP-IDF",
  "version": "0.1.0",
  "description": "ESP-IDF UART TX FIFO concrete provider composed into EDP-Serial",
  "repository": {
    "type": "git",
    "url": "https://github.com/ESPressio-Development-Platform/EDP-Serial-ESP-IDF.git"
  },
